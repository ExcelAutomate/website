---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase, type NavLabel } from '../data/nav';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: NavLabel;
  isContactPage?: boolean;
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, current, isContactPage = false, ogTitle, ogDescription } = Astro.props;

const ogImageUrl = new URL(withBase('/assets/img/excel-automate-og.png'), Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Derived from `site` in astro.config.mjs, not a separate flag to remember —
// noindex only applies while `site` is still the GitHub Pages staging
// domain. The pre-Netlify-launch checklist in README.md already requires
// updating `site` (and dropping `base`) to the real domain as its own,
// unavoidable step for the domain to work at all — this rides on that same
// change instead of needing a second manual edit that could ship by
// accident (see DECISIONS.md).
const STAGING_HOSTNAME = 'excelautomate.github.io';
const isStaging = Astro.site?.hostname === STAGING_HOSTNAME;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {
      /* Staging build on GitHub Pages: kept out of search results while
         placeholder article content remains (see DECISIONS.md). Comes off
         automatically once `site` in astro.config.mjs is updated to the
         real domain (isStaging above) — no separate manual removal step to
         forget. */
      isStaging && <meta name="robots" content="noindex, nofollow" />
    }

    <link rel="icon" type="image/svg+xml" href={withBase('/assets/img/excel-automate-favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/assets/img/excel-automate-favicon-32.png')} />
    <link rel="apple-touch-icon" href={withBase('/assets/img/excel-automate-favicon-256.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Public+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=Spectral:ital,wght@1,300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header current={current} isContactPage={isContactPage} />
    <main>
      <slot />
    </main>
    <Footer />
    <script src="../scripts/reveal.js"></script>
  </body>
</html>
