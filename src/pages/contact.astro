---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { NAV_HREFS } from '../data/nav';

const DETAILS = [
  { label: 'Email', value: 'hello@excelautomate.com.au', icon: 'mail' },
  { label: 'Based in', value: 'Hobart, Tasmania', icon: 'pin' },
  { label: 'Reply time', value: 'Within a day or two', icon: 'clock' },
];

const DETAIL_ICONS: Record<string, string> = {
  mail: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#146B3D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/></svg>',
  pin: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#146B3D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.1 7-11a7 7 0 10-14 0c0 4.9 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>',
  clock: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#146B3D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.4l3.4 2"/></svg>',
};
---

<BaseLayout
  title="Get in touch - Excel Automate | Hobart"
  description="Tell us about the process you'd like to simplify. Excel Automate builds Power Query and VBA tools for businesses and non-profits."
  current={undefined}
  isContactPage={true}
>
  <section class="contact-section">
    <div class="container contact-grid">
      <div class="contact-intro" data-reveal="intro">
        <h1 class="hero-heading">Let's <span class="accent">chat</span></h1>
        <div class="hero-rule"></div>
        <p class="hero-standfirst" style="margin-bottom: clamp(32px, 4vw, 48px);">
          Tell us about the process you'd like to simplify, or anything else we can help you with.
        </p>

        <div class="contact-details">
          {
            DETAILS.map((item) => (
              <div class="contact-detail-row">
                <div class="contact-detail-icon" set:html={DETAIL_ICONS[item.icon]} />
                <div>
                  <div class="contact-detail-label">{item.label}</div>
                  <div class="contact-detail-value">{item.value}</div>
                </div>
              </div>
            ))
          }
        </div>

        <div class="pulled-quote">
          <p>
            There's no cost and no obligation for a first conversation, and if Excel isn't the right answer
            <span style="white-space: nowrap;">we'll let you know.</span>
          </p>
        </div>
      </div>

      <ContactForm />
    </div>
  </section>

  <section class="cta-band cta-band--dark">
    <div class="cta-band-inner" data-reveal="learn">
      <h2>Learn more</h2>
      <p>Still weighing it up? See how we use <span class="accent">Modern Excel</span>, and how it can transform your processes.</p>
      <a href={NAV_HREFS['Our approach']} class="btn btn-ghost">Learn more</a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding: clamp(56px, 9vw, 100px) 24px clamp(48px, 8vw, 96px);
    background: var(--page);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.44fr);
    gap: clamp(32px, 4.5vw, 64px);
    align-items: start;
  }
  @media (max-width: 899px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Load-bearing cap — see Design Decisions - Contact page.md: this width is
     what breaks the standfirst after "simplify," and takes the pull quote to
     three lines with text-wrap: pretty. Re-measure if either sentence changes. */
  .contact-intro {
    max-width: 468px;
  }
  .contact-intro .hero-standfirst {
    text-wrap: pretty;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .contact-detail-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .contact-detail-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--icon-tile);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .contact-detail-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 3px;
  }
  .contact-detail-value {
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
  }
</style>
