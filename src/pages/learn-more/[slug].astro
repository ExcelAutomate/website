---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTIONS, TOP_SECTION_ID, sectionLabel } from '../../data/sections';
import { withBase } from '../../data/nav';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const label = sectionLabel(entry.data.section);
const backHref = withBase(`/learn-more/#${entry.data.section}`);
---

<BaseLayout
  title={`${entry.data.title} - Our approach - Excel Automate | Hobart`}
  description={entry.data.excerpt}
  current="Learn more"
>
  <section class="approach-hero-section">
    <div class="container approach-shell">
      <nav class="side-nav" aria-label="Sections">
        {
          SECTIONS.map((s) => (
            <a
              href={s.id === TOP_SECTION_ID ? withBase('/learn-more/') : withBase(`/learn-more/#${s.id}`)}
              class:list={['side-nav-link', { active: s.id === entry.data.section }]}
            >
              {s.label}
            </a>
          ))
        }
      </nav>

      <article class="article-col">
        <a href={backHref} class="back-link">&larr; {label}</a>

        <h1 class="article-title">{entry.data.title}</h1>

        <div class="article-body">
          {entry.data.status === 'written' ? <Content /> : <h2>Coming soon</h2>}
        </div>

        {
          entry.data.cta && (
            <div class="article-cta">
              <a href={withBase(`/learn-more/${entry.data.cta.target}/`)} class="btn btn-solid">
                {entry.data.cta.label}
              </a>
            </div>
          )
        }

        <div class="article-back-foot">
          <a href={backHref} class="back-link">&larr; Back to {label}</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<script src="../../scripts/article-nav.js"></script>

<style>
  /* Shell/side-nav geometry duplicated from learn-more/index.astro — see
     Build Notes: shared components should be built once, but this page's
     side nav is a static, non-highlighting variant (no sections to scroll
     past here), so it isn't worth factoring the whole shell into a
     component for a handful of shared rules. */
  .approach-hero-section {
    padding: clamp(56px, 9vw, 100px) 24px clamp(56px, 9vw, 100px);
    background: var(--page);
  }
  .approach-shell {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  .side-nav {
    position: sticky;
    top: 106px;
    margin-top: 10px;
    align-self: start;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px 12px;
    box-shadow: 0 2px 10px rgba(20, 40, 30, 0.06);
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .side-nav-link {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16.5px;
    line-height: 1.35;
    text-decoration: none;
    color: var(--text-body);
    background: transparent;
    padding: 11px 14px;
    border-radius: 10px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .side-nav-link:hover,
  .side-nav-link.active {
    background: var(--icon-tile);
    color: var(--green);
  }

  .article-col {
    max-width: 720px;
  }
  .back-link {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.35;
    text-decoration: none;
    color: var(--green);
    margin-bottom: 22px;
  }
  .article-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(30px, 4.2vw, 44px);
    line-height: 1.14;
    letter-spacing: -0.01em;
    margin: 0 0 clamp(20px, 2.6vw, 28px);
    color: var(--ink);
    text-wrap: pretty;
  }
  .article-cta {
    margin-top: clamp(30px, 3.6vw, 42px);
  }
  .article-back-foot {
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 26px;
    border-top: 1px solid #dceae1;
  }
  .article-back-foot .back-link {
    margin-bottom: 0;
  }

  @media (max-width: 899px) {
    .approach-shell {
      grid-template-columns: 1fr;
    }
    .side-nav {
      position: static;
      margin-top: 0;
      flex-direction: row;
      overflow-x: auto;
    }
  }
</style>
