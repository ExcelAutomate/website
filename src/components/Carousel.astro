---
// "What modern Excel can do" — five cards, alternating brand-green and
// near-black. Card 5 is deliberately shorter than the others (Design
// Decisions - Landing page.md: "don't rewrite it to even things up without
// asking").
const CARDS = [
  {
    title: 'Excel',
    text: 'Modern Excel is more than just spreadsheets and formulas. Under the hood is a powerful platform for processing your data and a bridge that brings your systems together. With a little help it can become the right solution rather than part of the problem.',
  },
  {
    title: 'Automate',
    text: 'Turn hours of manual data wrangling into the click of a few buttons, so you can focus on the things you do best. Let Excel take over the repetitive tasks, with efficient, robust, repeatable processes.',
  },
  {
    title: 'Integrate',
    text: 'Bring together data from all your different platforms and sources: cloud based systems, CSV exports, databases, PDFs and more. Combine, compare, and re-export with just a few clicks, or turn it into your own reporting dashboard.',
  },
  {
    title: 'Accelerate',
    text: "Speed up your processes and enable greater responsiveness - get work done when it's needed, without it disrupting your day. And with rapid development in Modern Excel, you can have custom tools built and ready to use faster than ever.",
  },
  {
    // The only card with deliberate line breaks - stored as real newlines,
    // rendered with `white-space: pre-line` on .carousel-card p (added for
    // this card only; it has no effect on the other four, whose text has no
    // newlines). Changes - 10 September 2026.md, #13.
    title: 'Transform',
    text: 'Transform your data and processes.\nTransform the way you see Excel.\nTransform the way you work.',
  },
];

// Cards alternate green/near-black so faded neighbours still read clearly.
function skinFor(i: number) {
  return i % 2 === 0
    ? { bg: '#146B3D', title: '#ffffff', body: 'var(--on-green-body)' }
    : { bg: '#15291D', title: '#ffffff', body: 'var(--on-dark-muted)' };
}

// The track renders three consecutive copies of the whole deck (15 slots),
// starting in the middle copy, so there's always a real card to slide onto
// in either direction and the arrows never need to rewind through the deck
// to wrap (see carousel.js). Only the middle copy is the "real" content as
// far as assistive tech is concerned - the other two exist purely so the
// peeks either side of it are never empty.
const COPIES = 3;
const MIDDLE_COPY = Math.floor(COPIES / 2);
---

<div class="carousel-block">
  <div class="carousel-viewport" id="carousel-viewport">
    <div class="carousel-track" id="carousel-track">
      {
        Array.from({ length: COPIES }).map((_, copyIndex) =>
          CARDS.map((card, i) => {
            const skin = skinFor(i);
            const isMiddleCopy = copyIndex === MIDDLE_COPY;
            return (
              <article
                class="carousel-card"
                data-carousel-card
                style={`background:${skin.bg}`}
                aria-hidden={isMiddleCopy ? undefined : 'true'}
                tabindex={isMiddleCopy ? undefined : -1}
              >
                <h2 style={`color:${skin.title}`}>{card.title}</h2>
                <p style={`color:${skin.body}`}>{card.text}</p>
              </article>
            );
          })
        )
      }
    </div>

    <button type="button" class="carousel-arrow carousel-arrow--prev" id="carousel-prev" aria-label="Previous">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#146B3D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 6l-6 6 6 6"></path>
      </svg>
    </button>
    <button type="button" class="carousel-arrow carousel-arrow--next" id="carousel-next" aria-label="Next">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#146B3D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 6l6 6-6 6"></path>
      </svg>
    </button>
  </div>

  <div class="carousel-dots">
    {
      CARDS.map((card, i) => (
        <button type="button" class="carousel-dot" data-dot-index={i} aria-label={`Show ${card.title}`}>
          <span />
        </button>
      ))
    }
  </div>
</div>

<script src="../scripts/carousel.js"></script>

<style>
  .carousel-block {
    position: relative;
  }
  .carousel-viewport {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    transition: width 0.45s var(--ease-reveal);
  }
  .carousel-track {
    display: flex;
    transition: transform 0.55s var(--ease-reveal);
  }
  .carousel-card {
    /* Reduced alongside the shorter card copy (#13) - the old floor left a
       band of empty space under four-line-or-fewer text (Changes - 10
       September 2026.md, #14). Still a minimum: below ~760px the text wraps
       further and cards grow past this on their own. */
    min-height: clamp(220px, 29vw, 290px);
    border-radius: 20px;
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: opacity 0.5s ease;
  }
  .carousel-card h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.35;
    margin: 0 0 16px;
  }
  .carousel-card p {
    font-family: var(--font-prose);
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0.01em;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.75;
    margin: 0;
    /* Only the Transform card's text has embedded newlines - harmless no-op
       on the other four (Changes - 10 September 2026.md, #13). */
    white-space: pre-line;
  }

  .carousel-arrow {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 52px;
    border: none;
    z-index: 5;
    display: flex;
    align-items: center;
  }
  .carousel-arrow--prev {
    left: 0;
    justify-content: flex-start;
    padding-left: 6px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
    transition: opacity 0.3s ease;
  }
  .carousel-arrow--next {
    right: 0;
    justify-content: flex-end;
    padding-right: 6px;
    background: linear-gradient(270deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
  }

  .carousel-dots {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-top: 24px;
  }
  .carousel-dot {
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    background: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .carousel-dot span {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--on-dark-muted);
    transition: background 0.25s ease, width 0.25s ease, height 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }
</style>
