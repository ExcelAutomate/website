---
// Animated mark — copied directly from the Brand Pack's
// design-pack/design/assets/animated-mark-snippet.html ("ready to paste"),
// rather than re-derived from the full Landing page source. Every movement
// is a native SVG <animate>/<animateTransform>/<animateMotion> tag: no CSS
// keyframes, no IDs to clash. An earlier hand-rolled version reimplemented
// the rotation/pulse/cell-flash as CSS @keyframes and got the cell-flash
// keyframe name out of sync with the element referencing it, silently
// breaking that animation — copying the snippet verbatim avoids that whole
// class of mistake. Only one animated instance per page (Brand Brief).
---

<svg
  viewBox="70 26 505 288"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="hero-mark-svg"
>
  <defs>
    <linearGradient id="eaFeed" gradientUnits="userSpaceOnUse" x1="205" y1="0" x2="262" y2="0">
      <stop offset="0" stop-color="#146B3D" stop-opacity="0"></stop>
      <stop offset="0.4" stop-color="#146B3D" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#146B3D" stop-opacity="1"></stop>
    </linearGradient>
  </defs>
  <g fill="none" stroke="url(#eaFeed)" stroke-width="3">
    <path d="M150 166H230C285 166 300 58 385 58"></path>
    <path d="M150 168H236C276 168 308 114 385 114"></path>
    <path d="M150 170H385"></path>
    <path d="M150 171H236C276 171 308 226 385 226"></path>
    <path d="M150 173H230C285 173 300 282 385 282"></path>
  </g>
  <g fill="#146B3D" class="hero-mark-dots">
    <circle r="7"
      ><animateMotion dur="3.2s" begin="0s" repeatCount="indefinite" path="M150 166H230C285 166 300 58 385 58"
      ></animateMotion><animate attributeName="opacity" values="0;0.35;1;1" keyTimes="0;0.12;0.28;1" dur="3.2s" begin="0s" repeatCount="indefinite"
      ></animate></circle
    >
    <circle r="7"
      ><animateMotion dur="3.2s" begin="-0.55s" repeatCount="indefinite" path="M150 168H236C276 168 308 114 385 114"
      ></animateMotion><animate attributeName="opacity" values="0;0.35;1;1" keyTimes="0;0.12;0.28;1" dur="3.2s" begin="-0.55s" repeatCount="indefinite"
      ></animate></circle
    >
    <circle r="7"
      ><animateMotion dur="3.2s" begin="-1.10s" repeatCount="indefinite" path="M150 170H385"
      ></animateMotion><animate attributeName="opacity" values="0;0.35;1;1" keyTimes="0;0.12;0.28;1" dur="3.2s" begin="-1.10s" repeatCount="indefinite"
      ></animate></circle
    >
    <circle r="7"
      ><animateMotion dur="3.2s" begin="-1.65s" repeatCount="indefinite" path="M150 171H236C276 171 308 226 385 226"
      ></animateMotion><animate attributeName="opacity" values="0;0.35;1;1" keyTimes="0;0.12;0.28;1" dur="3.2s" begin="-1.65s" repeatCount="indefinite"
      ></animate></circle
    >
    <circle r="7"
      ><animateMotion dur="3.2s" begin="-2.20s" repeatCount="indefinite" path="M150 173H230C285 173 300 282 385 282"
      ></animateMotion><animate attributeName="opacity" values="0;0.35;1;1" keyTimes="0;0.12;0.28;1" dur="3.2s" begin="-2.20s" repeatCount="indefinite"
      ></animate></circle
    >
  </g>
  <g transform="translate(157,200)">
    <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="26s" repeatCount="indefinite" additive="sum"
    ></animateTransform>
    <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D"></rect>
    <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(45)"></rect>
    <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(90)"></rect>
    <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(135)"></rect>
    <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(180)"></rect>
    <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(225)"></rect>
    <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(270)"></rect>
    <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(315)"></rect>
    <circle r="54" fill="#146B3D"></circle>
    <circle r="21" fill="#FCFDFC"></circle>
    <circle r="8" fill="#146B3D"></circle>
  </g>
  <g transform="translate(236,112)">
    <animateTransform attributeName="transform" type="rotate" from="0" to="-360" dur="17s" repeatCount="indefinite" additive="sum"
    ></animateTransform>
    <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D"></rect>
    <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(45)"></rect>
    <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(90)"></rect>
    <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(135)"></rect>
    <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(180)"></rect>
    <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(225)"></rect>
    <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(270)"></rect>
    <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(315)"></rect>
    <circle r="31" fill="#146B3D"></circle>
    <circle r="12" fill="#FCFDFC"></circle>
    <circle r="4.5" fill="#146B3D"></circle>
  </g>
  <rect x="385" y="30" width="186" height="56" fill="#146B3D">
    <animate attributeName="opacity" values="1;1;0.55;1" keyTimes="0;0.62;0.7;1" dur="3.2s" begin="0.96s" repeatCount="indefinite"></animate>
  </rect>
  <g stroke="#146B3D" stroke-width="3" fill="none">
    <rect x="385" y="30" width="186" height="280"></rect>
    <path d="M447 30v280M509 30v280M385 86h186M385 142h186M385 198h186M385 254h186"></path>
  </g>
  <g stroke="none" fill="#146B3D">
    <rect x="386" y="87" width="60" height="54" fill-opacity="0">
      <animate attributeName="fill-opacity" values="0;0;0.55;0" keyTimes="0;0.62;0.7;1" dur="3.2s" begin="0.41s" repeatCount="indefinite"></animate>
    </rect>
    <rect x="386" y="143" width="60" height="54" fill-opacity="0">
      <animate attributeName="fill-opacity" values="0;0;0.55;0" keyTimes="0;0.62;0.7;1" dur="3.2s" begin="-0.14s" repeatCount="indefinite"></animate>
    </rect>
    <rect x="386" y="199" width="60" height="54" fill-opacity="0">
      <animate attributeName="fill-opacity" values="0;0;0.55;0" keyTimes="0;0.62;0.7;1" dur="3.2s" begin="-0.69s" repeatCount="indefinite"></animate>
    </rect>
    <rect x="386" y="255" width="60" height="54" fill-opacity="0">
      <animate attributeName="fill-opacity" values="0;0;0.55;0" keyTimes="0;0.62;0.7;1" dur="3.2s" begin="-1.24s" repeatCount="indefinite"></animate>
    </rect>
  </g>
</svg>

<script>
  // SMIL animations have no CSS off-switch — pauseAnimations() is the actual
  // DOM API for it, and freezing (rather than removing) the elements keeps
  // the artwork's static state intact for reduced-motion users.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) {
    document.querySelectorAll('.hero-mark-svg').forEach((svg) => {
      if (svg instanceof SVGSVGElement) svg.pauseAnimations();
    });
  }
</script>

<style>
  .hero-mark-svg {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
