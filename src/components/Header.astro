---
import { NAV_LINKS, NAV_HREFS, OUR_APPROACH_SUB, CONTACT_HREF, withBase, type NavLabel } from '../data/nav';

interface Props {
  /** Which nav item to underline. Undefined on pages not in the nav (e.g. Contact). */
  current?: NavLabel;
  /** Contact page shows the CTA as a flat, non-interactive chip instead of a button. */
  isContactPage?: boolean;
}

const { current, isContactPage = false } = Astro.props;
---

<header class="site-header">
  <div class="header-row container">
    <a href={withBase('/')} class="lockup">
      <svg
        viewBox="70 26 505 288"
        class="lockup-mark"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id="headerMarkFeed" gradientUnits="userSpaceOnUse" x1="205" y1="0" x2="262" y2="0">
            <stop offset="0" stop-color="#146B3D" stop-opacity="0"></stop>
            <stop offset="0.4" stop-color="#146B3D" stop-opacity="0.35"></stop>
            <stop offset="1" stop-color="#146B3D" stop-opacity="1"></stop>
          </linearGradient>
        </defs>
        <g fill="none" stroke="url(#headerMarkFeed)" stroke-width="3">
          <path d="M150 166H230C285 166 300 58 385 58"></path>
          <path d="M150 168H236C276 168 308 114 385 114"></path>
          <path d="M150 170H385"></path>
          <path d="M150 171H236C276 171 308 226 385 226"></path>
          <path d="M150 173H230C285 173 300 282 385 282"></path>
        </g>
        <g transform="translate(157,200) rotate(11)">
          <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D"></rect>
          <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(45)"></rect>
          <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(90)"></rect>
          <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(135)"></rect>
          <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(180)"></rect>
          <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(225)"></rect>
          <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(270)"></rect>
          <rect x="-13" y="-72" width="26" height="22" rx="6" fill="#146B3D" transform="rotate(315)"></rect>
          <circle r="54" fill="#146B3D"></circle>
          <circle r="21" fill="#FFFFFF"></circle>
          <circle r="8" fill="#146B3D"></circle>
        </g>
        <g transform="translate(236,112) rotate(-6)">
          <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D"></rect>
          <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(45)"></rect>
          <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(90)"></rect>
          <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(135)"></rect>
          <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(180)"></rect>
          <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(225)"></rect>
          <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(270)"></rect>
          <rect x="-7.5" y="-40" width="15" height="13" rx="3.5" fill="#146B3D" transform="rotate(315)"></rect>
          <circle r="31" fill="#146B3D"></circle>
          <circle r="12" fill="#FFFFFF"></circle>
          <circle r="4.5" fill="#146B3D"></circle>
        </g>
        <rect x="385" y="30" width="186" height="56" fill="#146B3D"></rect>
        <g stroke="#146B3D" stroke-width="3" fill="none">
          <rect x="385" y="30" width="186" height="280"></rect>
          <path d="M447 30v280M509 30v280M385 86h186M385 142h186M385 198h186M385 254h186"></path>
        </g>
      </svg>
      <span class="lockup-text">
        <span class="lockup-word">Excel <span class="accent">Automate</span></span>
        <span class="lockup-tagline">INTEGRATE &middot; ACCELERATE &middot; TRANSFORM</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      <ul>
        {
          NAV_LINKS.map((label) => (
            <li class:list={['nav-item', { 'has-sub': label === 'Learn more' }]}>
              <a href={NAV_HREFS[label]} class:list={['nav-link', { current: current === label }]}>
                {label}
              </a>
              {label === 'Learn more' && (
                <div class="sub-menu">
                  <div class="sub-menu-inner">
                    {OUR_APPROACH_SUB.map((sub) => (
                      <a href={sub.href}>{sub.label}</a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
      {
        isContactPage ? (
          <span class="nav-cta nav-cta-chip">Get in touch</span>
        ) : (
          <a href={CONTACT_HREF} class="nav-cta btn-solid">
            Get in touch
          </a>
        )
      }
    </nav>

    <button
      type="button"
      class="burger"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      id="burger-btn"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav">
    <ul>
      {
        NAV_LINKS.map((label) => (
          <li>
            <a href={NAV_HREFS[label]} class:list={['mobile-nav-link', { current: current === label }]}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    {
      isContactPage ? (
        <span class="mobile-nav-cta nav-cta-chip">Get in touch</span>
      ) : (
        <a href={CONTACT_HREF} class="mobile-nav-cta btn-solid">
          Get in touch
        </a>
      )
    }
  </div>
</header>

<script>
  const burgerBtn = document.getElementById('burger-btn');
  const mobileNav = document.getElementById('mobile-nav');

  burgerBtn?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('is-open');
    burgerBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  // Close the mobile panel if the viewport grows past the burger breakpoint
  // while it's open (e.g. rotating a tablet).
  const mq = window.matchMedia('(min-width: 1040px)');
  mq.addEventListener('change', (e) => {
    if (e.matches) {
      mobileNav?.classList.remove('is-open');
      burgerBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // "Key ideas" in the dropdown points at the bare Our-approach URL (no
  // hash) so it lands at the top of the page from anywhere else on the site.
  // But clicking a link to the exact page you're already on doesn't
  // navigate at all by default (same-document, no hash to jump to) - so
  // when that's the case, do the scroll ourselves. Matches by "no hash and
  // same path" rather than by label, since Key ideas is the only sub-menu
  // item without a hash (Changes - 10 September 2026.md, #9).
  document.querySelectorAll<HTMLAnchorElement>('.sub-menu-inner a').forEach((link) => {
    link.addEventListener('click', (e) => {
      const url = new URL(link.href);
      if (!url.hash && url.pathname === window.location.pathname) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  // The dropdown opens on hover (CSS) or keyboard focus (:focus-within, CSS).
  // Escape closes it and returns focus to the parent link when focus is
  // anywhere inside it — the parent stays a working link either way.
  document.querySelectorAll('.has-sub').forEach((item) => {
    item.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        const parentLink = item.querySelector('a');
        (parentLink as HTMLElement | null)?.focus();
        (document.activeElement as HTMLElement | null)?.blur();
        parentLink instanceof HTMLElement && parentLink.focus();
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(252, 253, 252, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    padding-bottom: 10px;
    /* Row horizontal padding tightens with the viewport instead of .container's
       fixed 24px, so it can close up as the header approaches the burger
       breakpoint - 32px at 1240, 22px at 1120, floor 16px at 1040. The calc()
       offset gives it a real slope over that range; a plain vw clamp is far
       too shallow (Changes - 10 September 2026.md, #4 - measured, not
       guessed; re-measure before changing the nav, header button or lockup). */
    padding-left: clamp(16px, calc(8vw - 67.2px), 32px);
    padding-right: clamp(16px, calc(8vw - 67.2px), 32px);
    gap: clamp(10px, calc(7vw - 62.8px), 24px);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    text-decoration: none;
  }
  .lockup-mark {
    display: block;
    height: clamp(42px, 6.4vw, 66px);
    width: auto;
    flex-shrink: 0;
  }
  .lockup-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .lockup-word {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: clamp(19px, 3.1vw, 33px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }
  .lockup-word .accent {
    color: var(--green);
  }
  .lockup-tagline {
    font-family: var(--font-wordmark);
    font-weight: 600;
    font-size: clamp(7px, 1.2vw, 11.5px);
    /* Space Grotesk's own normal line-height (~1.27) — the wordmark above it
       pins line-height: 1 deliberately (sets the lockup's vertical rhythm,
       leave that alone), but the tagline itself has no such reason to be
       tight and the design doesn't set one either, so it should render at
       the font's natural value rather than inheriting the body's 1.6. */
    line-height: 1.27;
    letter-spacing: 0.2em;
    color: var(--green);
    white-space: nowrap;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, calc(9vw - 75.6px), 36px);
  }
  .main-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(18px, calc(9vw - 75.6px), 36px);
    margin: 0;
    padding: 0;
  }
  .nav-item {
    position: relative;
  }
  .nav-link {
    position: relative;
    display: block;
    white-space: nowrap;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.35;
    text-decoration: none;
    color: var(--text);
    padding-bottom: 6px;
    transition: color 0.2s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--green);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 0.28s var(--ease-reveal);
  }
  .nav-link:hover,
  .nav-link.current {
    color: var(--green);
  }
  .nav-link:hover::after,
  .nav-link.current::after {
    transform: scaleX(1);
  }

  /* Nav CTA has its own geometry, distinct from the page-body button variants
     — this must carry its own radius/padding since it isn't combined with
     the shared `.btn` class. One spec for the header button everywhere:
     18px font, 14px/26px padding, hover lift + shadow — matching the CTA
     band buttons' treatment rather than the burger button's plainer one
     (Changes - 10 September 2026.md, #6: the two differ deliberately,
     each sized to its own context — 18px next to 18px nav links here,
     17px next to 17px burger links there). */
  .nav-cta {
    flex-shrink: 0;
    white-space: nowrap;
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.35;
    text-decoration: none;
    padding: 14px 26px;
    border-radius: 10px;
    transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .nav-cta:hover {
    transform: translateY(-2px);
  }
  .nav-cta:active {
    transform: translateY(0);
  }
  .nav-cta-chip {
    color: var(--green);
    background: var(--icon-tile);
  }

  .sub-menu {
    position: absolute;
    top: 100%;
    left: -16px;
    padding-top: 12px; /* transparent bridge so hover survives the gap */
    z-index: 60;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .has-sub:hover .sub-menu,
  .has-sub:focus-within .sub-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .sub-menu-inner {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 28px rgba(20, 40, 30, 0.12);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 190px;
  }
  .sub-menu-inner a {
    display: block;
    white-space: nowrap;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.35;
    text-decoration: none;
    color: var(--text);
    padding: 10px 16px;
    border-radius: 8px;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .sub-menu-inner a:hover,
  .sub-menu-inner a:focus-visible {
    background: var(--icon-tile);
    color: var(--green);
  }

  .burger {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    flex-direction: column;
    gap: 5px;
    justify-content: center;
  }
  .burger span {
    display: block;
    width: 32px;
    height: 3px;
    background: var(--text);
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 0 24px;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
  }
  .mobile-nav.is-open {
    padding: 4px 24px 20px;
    max-height: 580px;
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-nav-link {
    position: relative;
    display: block;
    align-self: flex-start;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.35;
    text-decoration: none;
    color: var(--text);
    padding: 9px 0 10px;
  }
  .mobile-nav-link.current {
    color: var(--green);
  }
  /* `.mobile-nav` is a column flex container, whose default `align-items:
     stretch` would otherwise stretch this to the full width of the menu —
     every other item in the menu opts out with `align-self: flex-start`
     (see .mobile-nav-link), but the CTA link didn't in the original design,
     which is why it filled the width there. */
  .mobile-nav-cta {
    align-self: flex-start;
    margin-top: 6px;
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.35;
    text-decoration: none;
    padding: 13px 21px;
    border-radius: 10px;
    text-align: center;
    transition: background 0.2s ease;
  }
  /* Colour only, no lift - a 2px hover lift is a desktop-pointer affordance
     that reads as noise under a thumb. Combined with `.btn-solid` for the
     rest colours; its own hover box-shadow is suppressed here so the burger
     button stays flatter than the header one (Changes - 10 September 2026.md,
     #6). Two classes on the selector to out-rank `.btn-solid:hover` at equal
     specificity regardless of stylesheet order. */
  .mobile-nav-cta.btn-solid:hover {
    box-shadow: none;
  }

  /* Breakpoint driven by the nav's content width — re-check if items are
     added or renamed (Brand Brief > Breakpoints). Moved from 1180 to 1040
     once the header spacings above became clamps that tighten toward that
     width (Changes - 10 September 2026.md, #4): measured, the row stops
     fitting at ~1018px, so 1040 leaves 22px of headroom for font-loading
     variance. The binding constraint is the lockup, not the nav - going
     lower means shrinking the lockup's own clamp maxima, not done here. */
  @media (max-width: 1039px) {
    .main-nav {
      display: none;
    }
    .burger {
      display: flex;
    }
    .mobile-nav {
      display: flex;
    }
  }

  /* The tagline is part of the lockup, not a decoration on it - never shown
     without the wordmark above it, never removed while the wordmark stays.
     One threshold for both (LOCKUP_TEXT_MIN = 380), not two separate ones -
     they used to shed 220px apart, showing a wordmark with no tagline for
     that whole range (Changes - 10 September 2026.md, #5). */
  @media (max-width: 379px) {
    .lockup-text {
      display: none;
    }
  }
</style>
