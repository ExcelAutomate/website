---
// Netlify Forms is wired up now (data-netlify, honeypot, hidden form-name)
// even though GitHub Pages has no backend to receive it — see
// docs/Build Notes.md > Contact form and DECISIONS.md. The Netlify move
// later needs no markup changes, only turning the notification email on in
// the Netlify UI.
---

<div class="contact-form-card" data-reveal="form">
  <form
    id="contact-form"
    name="contact"
    method="POST"
    novalidate
    data-netlify="true"
    netlify-honeypot="bot-field"
  >
    <input type="hidden" name="form-name" value="contact" />
    <p class="visually-hidden">
      <label>Leave this field blank if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="field-grid">
      <label class="field">
        <span>Your name</span>
        <input type="text" name="name" required autocomplete="name" />
        <span class="field-error">Enter your name.</span>
      </label>
      <label class="field">
        <span>Organisation</span>
        <input type="text" name="organisation" placeholder="Optional" autocomplete="organization" />
      </label>
    </div>

    <label class="field">
      <span>Email</span>
      <input type="email" name="email" required autocomplete="email" />
      <span class="field-error">Enter a valid email address.</span>
    </label>

    <label class="field">
      <span>What you'd like help with</span>
      <textarea name="message" rows="5" required></textarea>
      <span class="field-error">Tell us a little about what you need.</span>
    </label>

    <div class="field">
      <span id="reply-pref-label">Preferred reply</span>
      <div class="segmented" role="radiogroup" aria-labelledby="reply-pref-label">
        <input type="radio" name="reply-preference" id="reply-email" value="email" checked class="visually-hidden" />
        <label for="reply-email" class="segmented-option" data-selected="true" data-reply-option="email">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/></svg>
          Email
        </label>
        <input type="radio" name="reply-preference" id="reply-phone" value="phone" class="visually-hidden" />
        <label for="reply-phone" class="segmented-option" data-selected="false" data-reply-option="phone">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3h3l1.5 4.2-2 1.4a11.5 11.5 0 005.4 5.4l1.4-2L20 13.5v3a2 2 0 01-2.2 2A15.5 15.5 0 015.5 5.2A2 2 0 016.5 3z"/></svg>
          Phone
        </label>
      </div>
    </div>

    <label class="field" id="phone-field" hidden>
      <span>Phone</span>
      <input type="tel" name="phone" autocomplete="tel" />
    </label>

    <button type="submit" class="btn btn-solid" id="contact-submit" style="width: 100%;">Send message</button>
  </form>

  <div id="contact-thanks" hidden>
    <div class="thanks-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#146B3D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
    </div>
    <h2>Thanks, that's on its way</h2>
    <p>You'll get a reply within a day or two.</p>
    <button type="button" id="contact-reset" class="text-link">Back to the form</button>
  </div>
</div>

<script src="../scripts/contact-form.js"></script>

<style>
  .contact-form-card {
    background: #ffffff;
    border-radius: 20px;
    padding: clamp(26px, 3.4vw, 40px);
    box-shadow: 0 2px 10px rgba(20, 40, 30, 0.06);
  }
  #contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 559px) {
    .field-grid {
      grid-template-columns: 1fr;
    }
  }

  #contact-thanks {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    padding: clamp(24px, 4vw, 48px) 0;
  }
  .thanks-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--icon-tile);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #contact-thanks h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 26px;
    margin: 0;
    color: var(--ink);
  }
  #contact-thanks p {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
    max-width: 380px;
  }
  .text-link {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--green);
    background: none;
    border: none;
    padding: 4px 0;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }
  .text-link:hover {
    color: var(--green-light);
  }
</style>
